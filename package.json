{
  "name": "@loranrendel/versoly-ui",
  "version": "4.0.1",
  "description": "Versoly UI - Tailwind CSS 4 framework based on Bootstrap",
  "keywords": [
    "bootstrap to tailwind",
    "dropdown Floating UI",
    "tailwind components",
    "tailwind elements",
    "tailwind library",
    "tailwind plugin",
    "tailwind sections",
    "tailwind ui",
    "tailwindcss 4",
    "ui kit"
  ],
  "homepage": "https://github.com/LoranRendel/versoly-ui#readme",
  "bugs": {
    "url": "https://github.com/LoranRendel/versoly-ui/issues"
  },
  "license": "MIT",
  "author": "Versoly",
  "contributors": [
    "Volkan Kaya <volkan@versoly.com>",
    "Loran A. Rendel <main@enjoytool.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoranRendel/versoly-ui.git"
  },
  "type": "module",
  "main": "./dist/versoly-ui.cjs",
  "module": "./dist/versoly-ui.mjs",
  "unpkg": "dist/versoly-ui.iife.js",
  "jsdelivr": "dist/versoly-ui.iife.js",
  "exports": {
    ".": {
      "import": "./dist/versoly-ui.mjs",
      "require": "./dist/versoly-ui.cjs"
    },
    "./plugin": {
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "pnpm run build",
    "build": "tsdown --config-loader unrun",
    "build:watch": "tsdown --config-loader unrun --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm run build && vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/node": "^4.3.3",
    "daisyui": "^5.7.46",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.20.3",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.2",
    "vite": "v8.0.0-beta.13",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
